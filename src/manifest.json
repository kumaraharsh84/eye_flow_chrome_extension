{
  "manifest_version": 3,
  "name": "EyeFlow - Doom Scroll Blocker & Eye Care",
  "version": "1.0.1",
  "description": "Detects doom scrolling on Instagram, YouTube & Reddit. Triggers guided eye breaks, gentle reminders, and hydration nudges. Smart enough to stay silent while you work.",

  "permissions": ["storage", "alarms", "notifications", "tabs", "idle", "offscreen"],

  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.youtube.com/*",
    "*://*.reddit.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.facebook.com/*",
    "*://*.tiktok.com/*",
    "*://*.snapchat.com/*",
    "*://*.formspree.io/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "incognito": "split",

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open EyeFlow Extension"
    },
    "trigger-eye-break": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Trigger an eye break right now"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}

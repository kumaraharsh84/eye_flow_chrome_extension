{
  "manifest_version": 3,
  "name": "EyeFlow - Doom Scroll Blocker & Eye Care",
  "version": "1.0.2",
  "description": "Spots doom scrolling and guides a short eye break. Gentle eye and water reminders that stay quiet while you work.",
  "minimum_chrome_version": "116",

  "permissions": ["storage", "alarms", "notifications", "idle", "offscreen"],

  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.youtube.com/*",
    "*://*.reddit.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.facebook.com/*",
    "*://*.tiktok.com/*",
    "*://*.snapchat.com/*",
    "*://*.linkedin.com/*",
    "*://*.twitch.tv/*"
  ],

  "optional_host_permissions": ["https://*/*"],

  "background": {
    "service_worker": "background.js"
  },

  "incognito": "split",

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "EyeFlow",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open EyeFlow"
    },
    "trigger-eye-break": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Start an eye break right now"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}

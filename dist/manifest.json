{
  "manifest_version": 3,
  "name": "EyeFlow - Doom Scroll Blocker & Eye Care",
  "version": "1.0.0",
  "description": "Detects doom scrolling on Instagram, YouTube & Reddit. Triggers guided eye breaks, gentle reminders, and hydration nudges. Smart enough to stay silent while you work.",

  "permissions": ["storage", "alarms", "notifications", "tabs", "idle", "offscreen"],

  "host_permissions": [
    "*://instagram.com/*",
    "*://*.instagram.com/*",
    "*://tiktok.com/*",
    "*://*.tiktok.com/*",
    "*://reddit.com/*",
    "*://*.reddit.com/*",
    "*://facebook.com/*",
    "*://*.facebook.com/*",
    "*://x.com/*",
    "*://*.x.com/*",
    "*://twitter.com/*",
    "*://*.twitter.com/*",
    "*://youtube.com/*",
    "*://*.youtube.com/*",
    "*://linkedin.com/*",
    "*://*.linkedin.com/*",
    "*://twitch.tv/*",
    "*://*.twitch.tv/*",
    "*://snapchat.com/*",
    "*://*.snapchat.com/*",
    "*://*.webhook.site/*",
    "*://*.formspree.io/*",
    "*://*.make.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "incognito": "split",

  "content_scripts": [
    {
      "matches": [
        "*://instagram.com/*",
        "*://*.instagram.com/*",
        "*://tiktok.com/*",
        "*://*.tiktok.com/*",
        "*://reddit.com/*",
        "*://*.reddit.com/*",
        "*://facebook.com/*",
        "*://*.facebook.com/*",
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*",
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://linkedin.com/*",
        "*://*.linkedin.com/*",
        "*://twitch.tv/*",
        "*://*.twitch.tv/*",
        "*://snapchat.com/*",
        "*://*.snapchat.com/*"
      ],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "MacCtrl+Shift+E"
      },
      "description": "Open EyeFlow Extension"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
